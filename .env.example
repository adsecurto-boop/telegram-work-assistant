BOT_TOKEN=
OWNER_ID=
SHIFT_TIMEZONE=Asia/Kolkata
# Existing DB_PATH, if present, remains the source JSON path.
# SQLITE_PATH=C:/Projects/TELEBOT/telegram-work-assistant/storage/work.sqlite3
REMINDERS_ENABLED=true
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Choose an available Gemini model from your account.
AI_MODEL=
AI_FALLBACK_MODEL=gemini-3.5-flash-lite
AI_DAILY_LIMIT=30
BACKUP_INTERVAL_HOURS=6
BACKUP_RETENTION=30
DASHBOARD_ENABLED=true
DASHBOARD_PORT=8765
MEDIA_RETENTION_DAYS=90
DELETE_VOICE_AFTER_TRANSCRIPTION=true
# Optional read-only connectors. API keys should be stored with scripts/configure_connectors.py.
FRESHDESK_DOMAIN=
FRESHDESK_AGENT_ID=
FRESHCHAT_BASE_URL=
FRESHCHAT_AGENT_ID=
ENABLED_CONNECTORS=
CONNECTOR_SYNC_MINUTES=15
