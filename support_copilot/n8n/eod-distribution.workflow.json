{
  "name": "Support Copilot - Signed EOD Distribution",
  "nodes": [
    {
      "name": "Daily Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 18
            }
          ]
        }
      }
    },
    {
      "name": "Build Signed Export Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 0],
      "parameters": {
        "jsCode": "const crypto = require('crypto');\n\nconst secret = $env.COPILOT_N8N_SHARED_SECRET || '';\nif (!secret) { throw new Error('COPILOT_N8N_SHARED_SECRET is not configured'); }\nconst timestamp = Math.floor(Date.now() / 1000).toString();\nconst eventId = 'n8n-eod-' + crypto.randomUUID();\nconst capability = 'report:export';\n\nconst payloadObj = {\n  report_date: null,\n  report_type: 'eod'\n};\nconst canonicalBody = JSON.stringify(payloadObj, Object.keys(payloadObj).sort());\nconst message = `${timestamp}.${eventId}.${capability}.${canonicalBody}`;\nconst signature = crypto.createHmac('sha256', secret).update(message, 'utf8').digest('hex');\n\nreturn [\n  {\n    json: {\n      headers: {\n        'X-Copilot-Timestamp': timestamp,\n        'X-Copilot-Event-ID': eventId,\n        'X-Copilot-Capability': capability,\n        'X-Copilot-Signature': signature,\n        'Content-Type': 'application/json'\n      },\n      body: canonicalBody\n    }\n  }\n];"
      }
    },
    {
      "name": "Fetch Finalized EOD",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 0],
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8000/v1/integrations/n8n/report-export",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Copilot-Timestamp",
              "value": "={{ $json.headers['X-Copilot-Timestamp'] }}"
            },
            {
              "name": "X-Copilot-Event-ID",
              "value": "={{ $json.headers['X-Copilot-Event-ID'] }}"
            },
            {
              "name": "X-Copilot-Capability",
              "value": "={{ $json.headers['X-Copilot-Capability'] }}"
            },
            {
              "name": "X-Copilot-Signature",
              "value": "={{ $json.headers['X-Copilot-Signature'] }}"
            },
            {
              "name": "Content-Type",
              "value": "={{ $json.headers['Content-Type'] }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}",
        "options": {
          "timeout": 10000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          }
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "name": "Approved Distribution Target",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [720, 0],
      "parameters": {}
    }
  ],
  "connections": {
    "Daily Schedule": {
      "main": [
        [
          {
            "node": "Build Signed Export Request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Signed Export Request": {
      "main": [
        [
          {
            "node": "Fetch Finalized EOD",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Finalized EOD": {
      "main": [
        [
          {
            "node": "Approved Distribution Target",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
