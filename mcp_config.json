{
  "mcpServers": {
    "github": {
      "enabled": false,
      "transport": "streamable_http",
      "url": "https://api.githubcopilot.com/mcp/",
      "trusted_endpoint": "https://api.githubcopilot.com/mcp/",
      "trust_tool_annotations": true,
      "read_only_tools": ["get_issue", "search_issues", "list_issues", "get_pull_request", "search_repositories", "get_file_contents", "get_me"],
      "headers": {
        "Authorization": "Bearer ${GITHUB_TOKEN}",
        "X-MCP-Toolsets": "issues,pull_requests,repos,users",
        "X-MCP-Readonly": "true"
      }
    },
    "filesystem": {
      "enabled": false,
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "./storage"],
      "env": {}
    },
    "mock_test": {
      "enabled": false,
      "transport": "stdio",
      "command": "python",
      "args": ["-m", "tests.mock_mcp_server"],
      "env": {}
    }
  }
}
